<% layout("/layouts/boilerplate") %>
  <body>
    <div class="row mt-3">
      <div class="col-8 offset-3">
        <h3>Listing Details :</h3>
      </div>
      <div class="card col-6 offset-3 show-card listing-card">
      <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
          <p class="card-text">
            Owned By: <i><%= listing.owner ? listing.owner.username : "Unknown" %></i><br>
          </p>

          <p><%= listing.description %><br></p>
          <p>&#8377; <%= listing.price != null ? listing.price.toLocaleString("en-IN") : "N/A" %><br></p>

          <p><%= listing.location %><br></p>
          <p><%= listing.country %><br></p>
          </p>
        </div>
      </div>
      <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
      <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>
        <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
           <button class="btn btn-dark offset-5">Delete</button>
        </form>
      </div>
      <% } %>

      <div class="col-8 offset-3 mb-3">
        <br>
        <% if(currUser) {%>
        <h4>Leave a Review</h4>

<form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
  <div class="mb-3">
    <label for="rating" class="form-label">Rating</label>

    <fieldset class="starability-slot">
      <input type="radio" id="rate1" name="review[rating]" value="1" />
      <label for="rate1" title="Terrible">1 star</label>

      <input type="radio" id="rate2" name="review[rating]" value="2" />
      <label for="rate2" title="Not good">2 stars</label>

      <input type="radio" id="rate3" name="review[rating]" value="3" />
      <label for="rate3" title="Average">3 stars</label>

      <input type="radio" id="rate4" name="review[rating]" value="4" />
      <label for="rate4" title="Very good">4 stars</label>

      <input type="radio" id="rate5" name="review[rating]" value="5" checked />
      <label for="rate5" title="Amazing">5 stars</label>
    </fieldset>
  </div>

  <div class="mb-3">
    <label for="comment" class="form-label">Comments</label>
    <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
    <div class="invalid-feedback">Please submit some comments</div>
  </div>

  <button class="btn btn-outline-dark">Submit</button>
</form>

        <% } %>
        <hr/>

        <ul>
          <% if(listing.reviews.length>0) { %>
          <div class="row">
            <h4>All Review</h4>
          <% for(review of listing.reviews){ %>
            <div class="card col-5 ms-3 mb-3">
              <div class="card-body">
                <h5 class="card-body">
                  @<%= review.author ? review.author.username : "Unknown" %>
                </h5>
                <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                <p class="card-text"><%= review.comment%></p>
              </div>
              <form mb="3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-dark">Delete</button>
              </form>
            </div>
          <% } %>
          </div>
          <% } %>
        </ul>
      </div>
      <div class="col-8 offset-3 mb-3">
  <h3>Where you'll be</h3>
  <div id="map" style="height: 400px;"></div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  // Use the listing's location from EJS
  const locationName = "<%= listing.location %>";

  // Initialize the map with a default view
  var map = L.map("map").setView([20, 0], 2); // default view if geocoding fails

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/">OpenStreetMap</a> contributors'
  }).addTo(map);

  // Forward geocode the location using Nominatim
  fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(locationName)}`)
    .then(response => response.json())
    .then(data => {
      if(data && data.length > 0) {
        const lat = data[0].lat;
        const lon = data[0].lon;

        map.setView([lat, lon], 13); // zoom in on the location

        L.marker([lat, lon])
          .addTo(map)
          .bindPopup(`<b>${locationName}</b>`)
          .openPopup();
      } else {
        console.error("Location not found!");
      }
    })
    .catch(err => console.error(err));
</script>

  </body>